{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://miscotools.local/dilstout/plugin-manifest.schema.json",
  "title": "Dilstout Plugin Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "id", "name", "version", "apiVersion", "entry", "capabilities"],
  "properties": {
    "format": { "const": "dilstout.plugin" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "apiVersion": { "type": "integer", "minimum": 1 },
    "entry": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "author": { "type": "string" },
    "license": { "type": "string" },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "slot",
          "phonemeResolver",
          "renderer",
          "speaker",
          "prosody",
          "category",
          "importer",
          "exporter",
          "validator",
          "uiPanel"
        ]
      }
    }
  }
}
