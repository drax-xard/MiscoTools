{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://miscotools.local/dilstout/lpp.schema.json",
  "title": "Dilstout Language Pack Preset",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "name", "laps", "seed", "strategy", "renderer"],
  "properties": {
    "format": { "const": "dilstout.lpp" },
    "version": { "type": "integer", "minimum": 1 },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "laps": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/lapRef" }
    },
    "seed": { "type": "string", "minLength": 1 },
    "strategy": { "type": "string", "minLength": 1 },
    "renderer": { "type": "string", "minLength": 1 },
    "blendStrength": { "type": "number", "minimum": 0, "maximum": 1 },
    "pins": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 1 }
    },
    "createdAt": { "type": "string" }
  },
  "$defs": {
    "lapRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "weight"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "weight": { "type": "number", "minimum": 0 },
        "overrides": {
          "type": "object",
          "additionalProperties": { "type": "number", "minimum": 0 }
        }
      }
    }
  }
}
