    "prosody": {
      "stress": "penultimate",
      "syllableTemplate": "(C)V(C)",
      "tempo": 1,
      "vowelLengthDistinctive": false,
      "tone": null
    },
    "joinRules": [
      { "type": "dropDuplicate" },
      { "type": "elideVowel", "from": "a", "to": "", "when": "beforeVowel" },
      { "type": "assimilate", "from": "n", "to": "m", "before": ["b", "p", "m"] }
    ]
