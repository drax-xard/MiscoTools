      "onsets": ["p", "b", "t", "d", "k", "g", "f", "v", "s", "z", "ʃ", "tʃ", "h", "m", "n", "l", "r", "j", "w"],
      "nuclei": ["a", "e", "i", "o", "u"],
      "codas": ["n", "r", "l", "s", "m"],
      "notes": "Synthetic; no strict constraints enforced in v1."
