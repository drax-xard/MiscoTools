{
  "format": "dilstout.lap",
  "version": 1,
  "meta": {
    "id": "ancient-babylonian",
    "name": "Ancient Babylonian",
    "culture": "Akkadian (Old Babylonian)",
    "era": "c. 2000-1600 BCE",
    "author": "Dilstout",
    "license": "CC0-1.0 (compilation); cited sources retain their own rights",
    "sources": [
      "Huehnergard, J. (2011). A Grammar of Akkadian, 3rd ed. Eisenbrauns.",
      "Black, J., George, A., & Postgate, N. (2000). A Concise Dictionary of Akkadian. Harrassowitz.",
      "Gelb, I. J. (1980). Computer-Aided Analysis of Amorite. University of Chicago Press.",
      "The Assyrian Dictionary of the Oriental Institute of the University of Chicago (CAD)."
    ],
    "notes": "ASCII transliteration: sh = s, kh = h with a dot, ts = s with a dot, q = emphatic k; vowel length is not marked. Models naming patterns, not fluent Akkadian. Experimental; not reviewed by a specialist.",
    "status": "experimental"
  },
  "phonology": {
    "inventory": [
      { "symbol": "p", "type": "consonant", "place": "bilabial", "manner": "stop", "voicing": "voiceless" },
      { "symbol": "b", "type": "consonant", "place": "bilabial", "manner": "stop", "voicing": "voiced" },
      { "symbol": "t", "type": "consonant", "place": "alveolar", "manner": "stop", "voicing": "voiceless" },
      { "symbol": "d", "type": "consonant", "place": "alveolar", "manner": "stop", "voicing": "voiced" },
      { "symbol": "k", "type": "consonant", "place": "velar", "manner": "stop", "voicing": "voiceless" },
      { "symbol": "g", "type": "consonant", "place": "velar", "manner": "stop", "voicing": "voiced" },
      { "symbol": "q", "type": "consonant", "place": "uvular", "manner": "stop", "voicing": "voiceless" },
      { "symbol": "ts", "type": "consonant", "place": "alveolar", "manner": "affricate", "voicing": "voiceless" },
      { "symbol": "s", "type": "consonant", "place": "alveolar", "manner": "fricative", "voicing": "voiceless" },
      { "symbol": "ʃ", "type": "consonant", "place": "postalveolar", "manner": "fricative", "voicing": "voiceless" },
      { "symbol": "x", "type": "consonant", "place": "velar", "manner": "fricative", "voicing": "voiceless" },
      { "symbol": "h", "type": "consonant", "place": "glottal", "manner": "fricative", "voicing": "voiceless" },
      { "symbol": "m", "type": "consonant", "place": "bilabial", "manner": "nasal", "voicing": "voiced" },
      { "symbol": "n", "type": "consonant", "place": "alveolar", "manner": "nasal", "voicing": "voiced" },
      { "symbol": "l", "type": "consonant", "place": "alveolar", "manner": "lateral", "voicing": "voiced" },
      { "symbol": "r", "type": "consonant", "place": "alveolar", "manner": "trill", "voicing": "voiced" },
      { "symbol": "w", "type": "consonant", "place": "labiovelar", "manner": "approximant", "voicing": "voiced" },
      { "symbol": "j", "type": "consonant", "place": "palatal", "manner": "approximant", "voicing": "voiced" },
      { "symbol": "z", "type": "consonant", "place": "alveolar", "manner": "fricative", "voicing": "voiced" },
      { "symbol": "a", "type": "vowel", "height": "open", "backness": "central", "rounded": false, "length": "short" },
      { "symbol": "e", "type": "vowel", "height": "mid", "backness": "front", "rounded": false, "length": "short" },
      { "symbol": "i", "type": "vowel", "height": "close", "backness": "front", "rounded": false, "length": "short" },
      { "symbol": "u", "type": "vowel", "height": "close", "backness": "back", "rounded": true, "length": "short" }
    ],
    "romanization": {
      "a": "a",
      "b": "b",
      "d": "d",
      "e": "e",
      "g": "g",
      "h": "h",
      "i": "i",
      "k": "k",
      "kh": "x",
      "l": "l",
      "m": "m",
      "n": "n",
      "p": "p",
      "q": "q",
      "r": "r",
      "s": "s",
      "sh": "ʃ",
      "t": "t",
      "ts": "ts",
      "u": "u",
      "w": "w",
      "y": "j",
      "z": "z"
    },
    "phonotactics": {
      "onsets": ["p", "b", "t", "d", "k", "g", "q", "m", "n", "l", "r", "s", "ʃ", "x", "h", "w", "j", "z", "ts"],
      "nuclei": ["a", "e", "i", "u"],
      "codas": ["m", "n", "l", "r", "s", "ʃ", "x", "k", "b", "d"],
      "notes": "Roots are compatible with common Akkadian syllable shapes; v1 does not enforce a full syllabifier."
    },
    "prosody": {
      "stress": "penultimate",
      "syllableTemplate": "(C)V(C)",
      "tempo": 1,
      "vowelLengthDistinctive": true,
      "tone": null
    },
    "joinRules": [
      { "type": "dropDuplicate" },
      { "type": "elideVowel", "from": "a", "to": "", "when": "beforeVowel" },
      { "type": "assimilate", "from": "n", "to": "m", "before": ["b", "p", "m"] }
    ]
  },
