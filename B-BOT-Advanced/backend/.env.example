# B-BOT Advanced environment configuration
# Copy to .env and fill in your values

# API configuration
API_HOST=0.0.0.0
API_PORT=8000

# Authentication
AUTH_TOKEN=change-this-to-a-secret-token

# LLM endpoint
LLM_ENDPOINT=http://inference-machine:8000/v1/chat/completions

# Whisper endpoint
WHISPER_ENDPOINT=http://inference-machine:8000/v1/transcriptions

# Voice devices
MIC_DEVICE=
SPEAKER_DEVICE=

# Notification channels
TELEGRAM_BOT_TOKEN=
WHATSAPP_PROVIDER_URL=