# B-BOT Advanced environment configuration.
# Copy to .env and fill in your values. Values here override config.yaml.

# Required: household-wide bearer token used by every authenticated endpoint.
B_BOT_AUTH_TOKEN=change-this-to-a-secret-token

# Optional server overrides.
B_BOT_HOST=127.0.0.1
B_BOT_PORT=8000

# OpenAI-compatible inference endpoint.
B_BOT_LLM_BASE_URL=http://inference-machine:8080/v1
B_BOT_LLM_MODEL=
B_BOT_LLM_API_KEY=

# Remote Whisper endpoint.
B_BOT_STT_BASE_URL=http://inference-machine:8080/v1
B_BOT_STT_MODEL=whisper-1

# Storage.
B_BOT_DATABASE_PATH=data/b-bot.db
