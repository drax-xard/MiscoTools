# B-BOT Advanced environment configuration.
# Copy to .env and fill in your values. Values here override config.yaml.

# Required: household-wide bearer token used by every authenticated endpoint.
# Generate a strong secret (e.g., `openssl rand -hex 32`) and set it here.
B_BOT_AUTH_TOKEN=
# During token rotation, keep the old token valid temporarily.
# B_BOT_AUTH_TOKEN_PREVIOUS=

# Optional server overrides.
B_BOT_HOST=127.0.0.1
B_BOT_PORT=8000

# OpenAI-compatible inference endpoint. Use HTTPS; plaintext HTTP is rejected
# for non-loopback hosts unless B_BOT_ALLOW_INSECURE_TRANSPORT=true.
B_BOT_LLM_BASE_URL=https://inference-machine/v1
B_BOT_LLM_MODEL=
B_BOT_LLM_API_KEY=

# Remote Whisper endpoint.
B_BOT_STT_BASE_URL=https://inference-machine/v1
B_BOT_STT_MODEL=whisper-1

# Transport hardening.
B_BOT_ALLOW_INSECURE_TRANSPORT=false
B_BOT_TRUST_PROXY_HEADERS=false

# Interactive docs are off by default; enable only on loopback during development.
B_BOT_DOCS_ENABLED=false

# Abuse controls (per client IP, per process).
B_BOT_RATE_LIMIT_PER_MINUTE=120
B_BOT_AUTH_MAX_FAILURES=5
B_BOT_AUTH_LOCKOUT_SECONDS=300
B_BOT_MAX_REQUEST_BODY_BYTES=1000000
B_BOT_MAX_RESPONSE_BYTES=200000
B_BOT_MAX_CONCURRENT_STREAMS=4
B_BOT_MAX_HISTORY_MESSAGES=40
B_BOT_MAX_HISTORY_CHARS=24000

# Delete conversations/audit rows older than this many days (0 = keep forever).
B_BOT_RETENTION_DAYS=0

# Storage.
B_BOT_DATABASE_PATH=data/b-bot.db
